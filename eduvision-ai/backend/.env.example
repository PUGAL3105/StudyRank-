# ==============================================================================
# EduVision AI — Backend Production Environment Variables (.env.example)
# ==============================================================================

PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://eduvision.example.com,http://localhost:5173

# PostgreSQL & pgvector Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/eduvision_ai?sslmode=prefer
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduvision_ai
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# OpenAI RAG & Vector Embeddings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
