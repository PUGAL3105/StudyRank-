# ==============================================================================
# EduVision AI — Production Environment Variable Configuration Template
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Security & Tokens
JWT_SECRET=change_this_to_a_secure_64_character_random_hex_string_in_production
SESSION_SECRET=change_this_to_another_secure_64_character_random_hex_string

# PostgreSQL + pgvector Production Credentials
DB_HOST=postgres
DB_PORT=5432
DB_NAME=eduvision_db
DB_USER=postgres
DB_PASSWORD=change_this_production_database_password

# Database URL Connection String
DATABASE_URL=postgresql://postgres:change_this_production_database_password@postgres:5432/eduvision_db

# Storage Directory for Uploaded Authentic PDFs
STORAGE_DIR=/app/data/storage

# CORS Allowed Origins (Comma-separated for multi-domain)
CORS_ORIGINS=https://eduvision.ai,https://www.eduvision.ai,http://localhost

# OpenAI / AI Provider API Key (Optional for cloud LLMs, local embeddings used by default)
OPENAI_API_KEY=

# File Upload Limits
MAX_UPLOAD_SIZE_MB=50
